# eDiscovery Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================================================
# SECURITY - REQUIRED
# ============================================================================

# JWT Secret Key - MUST be a secure random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-random-secret-key-change-this-in-production

# OpenAI API Key for AI-powered document analysis
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# DATABASE - REQUIRED
# ============================================================================

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name (optional, defaults to 'ediscovery')
# MONGO_DB_NAME=ediscovery

# ============================================================================
# MESSAGING - OPTIONAL
# ============================================================================

# NATS server for distributed agent communication
# If not set, the system will fall back to direct API calls
NATS_URL=nats://localhost:4222

# ============================================================================
# SEARCH - OPTIONAL
# ============================================================================

# Elasticsearch for full-text search and aggregations
# If not set, basic MongoDB search will be used
ELASTICSEARCH_URL=http://localhost:9200

# ============================================================================
# APPLICATION SETTINGS - OPTIONAL
# ============================================================================

# JWT token expiration time in minutes (default: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server host and port
# HOST=0.0.0.0
# PORT=8000

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING - OPTIONAL
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ============================================================================
# DEVELOPMENT - OPTIONAL
# ============================================================================

# Enable development mode features
# DEV_MODE=false

# Disable authentication (for local testing only - NEVER in production!)
# DISABLE_AUTH=false
